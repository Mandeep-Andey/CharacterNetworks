{"event_id":"ch1_scene_3_e1","scene_id":"ch1_scene_3","chapter_num":1,"book_num":1,"participants":[{"canonical_id":"Mr. Nicholas Bulstrode","display_name":"Mr. Nicholas Bulstrode","role_in_event":"initiator"},{"canonical_id":"Kate Bulstrode","display_name":"Kate Bulstrode","role_in_event":"recipient"}],"interaction_kind":"spoken_exchange","direction":"a_to_b","medium":"spoken","evidence_xml_ids":["ch1_q44"],"evidence_texts":["“Here, Kitty, come and look at my plan; I shall think I am a great architect, if I have not got incompatible stairs and fireplaces.”"],"dialogue_quote_ids":["ch1_q44"],"provenance":{"method":"structural","source_stage":"F_interaction","llm_model":null,"llm_backend":null,"prompt_hash":null,"input_hash":null,"cache_key":null,"alias_kb_version":"char_alias_optimized.json","code_commit":"145c589"},"flags":[]}
{"event_id":"ch1_scene_3_e2","scene_id":"ch1_scene_3","chapter_num":1,"book_num":1,"participants":[{"canonical_id":"Dorothea Brooke","display_name":"Dorothea Brooke","role_in_event":"initiator"}],"interaction_kind":"spoken_exchange","direction":"undirected","medium":"spoken","evidence_xml_ids":["ch1_q24","ch1_q28","ch1_q29","ch1_q32","ch1_q35","ch1_q36","ch1_q37","ch1_q38","ch1_q40"],"evidence_texts":["“No, I have other things of mamma’s—her sandal-wood box which I am so fond of—plenty of things. In fact, they are all yours, dear. We need discuss them no longer. There—take away your property.”","“How very beautiful these gems are!”","“It is strange how deeply colors seem to penetrate one, like scent. I suppose that is the reason why gems are used as spiritual emblems in the Revelation of St. John. They look like fragments of heave","“They are lovely,”","“Yes! I will keep these—this ring and bracelet,”","“Yet what miserable men find such things, and work at them, and sell them!”","“Yes, dear, I will keep these,”","“But take all the rest away, and the casket.”","“Perhaps,”"],"dialogue_quote_ids":["ch1_q24","ch1_q28","ch1_q29","ch1_q32","ch1_q35","ch1_q36","ch1_q37","ch1_q38","ch1_q40"],"provenance":{"method":"structural","source_stage":"F_interaction","llm_model":null,"llm_backend":null,"prompt_hash":null,"input_hash":null,"cache_key":null,"alias_kb_version":"char_alias_optimized.json","code_commit":"145c589"},"flags":["ambiguous_addressee"]}
{"event_id":"ch1_scene_3_e3","scene_id":"ch1_scene_3","chapter_num":1,"book_num":1,"participants":[{"canonical_id":"Celia Brooke","display_name":"Celia Brooke","role_in_event":"initiator"}],"interaction_kind":"spoken_exchange","direction":"undirected","medium":"spoken","evidence_xml_ids":["ch1_q25","ch1_q26","ch1_q27","ch1_q30","ch1_q31","ch1_q33","ch1_q34","ch1_q39","ch1_q42","ch1_q43"],"evidence_texts":["“But how can I wear ornaments if you, who are the elder sister, will never wear them?”","“Nay, Celia, that is too much to ask, that I should wear trinkets to keep you in countenance. If I were to put on such a necklace as that, I should feel as if I had been pirouetting. The world would g","“It would be a little tight for your neck; something to lie down and hang would suit you better,”","“And there is a bracelet to match it,”","“We did not notice this at first.”","“You would like those, Dorothea,”","“You must keep that ring and bracelet—if nothing else. But see, these agates are very pretty and quiet.”","“Shall you wear them in company?”","“I am sure—at least, I trust,”","“that the wearing of a necklace will not interfere with my prayers. And I do not see that I should be bound by Dorothea’s opinions now we are going into society, though of course she herself ought to "],"dialogue_quote_ids":["ch1_q25","ch1_q26","ch1_q27","ch1_q30","ch1_q31","ch1_q33","ch1_q34","ch1_q39","ch1_q42","ch1_q43"],"provenance":{"method":"structural","source_stage":"F_interaction","llm_model":null,"llm_backend":null,"prompt_hash":null,"input_hash":null,"cache_key":null,"alias_kb_version":"char_alias_optimized.json","code_commit":"145c589"},"flags":["ambiguous_addressee"]}
