{"event_id":"ch1_scene_1_e4","scene_id":"ch1_scene_1","chapter_num":1,"book_num":1,"participants":[{"canonical_id":"Celia Brooke","display_name":"Celia Brooke","role_in_event":"participant"},{"canonical_id":"Dorothea Brooke","display_name":"Dorothea Brooke","role_in_event":"participant"},{"canonical_id":"Mr. Arthur Brooke","display_name":"Mr. Arthur Brooke","role_in_event":"participant"},{"canonical_id":"Mrs. Elinor Cadwallader","display_name":"Mrs. Elinor Cadwallader","role_in_event":"mentioned_absent"}],"interaction_kind":"mention_in_absence","direction":"undirected","medium":"unspecified","evidence_xml_ids":["ch1_p9_persName4"],"evidence_texts":["Mrs. Cadwallader"],"dialogue_quote_ids":[],"provenance":{"method":"structural","source_stage":"F_interaction","llm_model":null,"llm_backend":null,"prompt_hash":null,"input_hash":null,"cache_key":null,"alias_kb_version":"char_alias_optimized.json","code_commit":"145c589"},"flags":[]}
{"event_id":"ch1_scene_2_e1","scene_id":"ch1_scene_2","chapter_num":1,"book_num":1,"participants":[{"canonical_id":"Dorothea Brooke","display_name":"Dorothea Brooke","role_in_event":"initiator"}],"interaction_kind":"spoken_exchange","direction":"undirected","medium":"spoken","evidence_xml_ids":["ch1_q5","ch1_q6","ch1_q7","ch1_q8","ch1_q9","ch1_q10","ch1_q11","ch1_q16","ch1_q19","ch1_q21","ch1_q22"],"evidence_texts":["“What a wonderful little almanac you are, Celia! Is it six calendar or six lunar months?”","“It is the last day of September now, and it was the first of April when uncle gave them to you. You know, he said that he had forgotten them till then. I believe you have never thought of them since ","“Well, dear, we should never wear them, you know.”","“I think, dear, we are wanting in respect to mamma’s memory, to put them by and take no notice of them. And,”","“necklaces are quite usual now; and Madame Poincon, who was stricter in some things even than you are, used to wear ornaments. And Christians generally—surely there are women in heaven now who wore je","“You would like to wear them?”","“Of course, then, let us have them out. Why did you not tell me before? But the keys, the keys!”","“No, no, dear, no,”","“Not for the world, not for the world. A cross is the last thing I would wear as a trinket.”","“No, dear, no,”","“Souls have complexions too: what will suit one will not suit another.”"],"dialogue_quote_ids":["ch1_q5","ch1_q6","ch1_q7","ch1_q8","ch1_q9","ch1_q10","ch1_q11","ch1_q16","ch1_q19","ch1_q21","ch1_q22"],"provenance":{"method":"structural","source_stage":"F_interaction","llm_model":null,"llm_backend":null,"prompt_hash":null,"input_hash":null,"cache_key":null,"alias_kb_version":"char_alias_optimized.json","code_commit":"145c589"},"flags":["ambiguous_addressee"]}
{"event_id":"ch1_scene_2_e2","scene_id":"ch1_scene_2","chapter_num":1,"book_num":1,"participants":[{"canonical_id":"Celia Brooke","display_name":"Celia Brooke","role_in_event":"initiator"}],"interaction_kind":"spoken_exchange","direction":"undirected","medium":"spoken","evidence_xml_ids":["ch1_q12","ch1_q13","ch1_q14","ch1_q15","ch1_q17","ch1_q18","ch1_q20","ch1_q23"],"evidence_texts":["“They are here,”","“Pray open the large drawer of the cabinet and get out the jewel-box.”","“There, Celia! you can wear that with your Indian muslin. But this cross you must wear with your dark dresses.”","“O Dodo, you must keep the cross yourself.”","“Yes, indeed you must; it would suit you—in your black dress, now,”","“You might wear that.”","“Then you will think it wicked in me to wear it,”","“But you might like to keep it for mamma’s sake.”"],"dialogue_quote_ids":["ch1_q12","ch1_q13","ch1_q14","ch1_q15","ch1_q17","ch1_q18","ch1_q20","ch1_q23"],"provenance":{"method":"structural","source_stage":"F_interaction","llm_model":null,"llm_backend":null,"prompt_hash":null,"input_hash":null,"cache_key":null,"alias_kb_version":"char_alias_optimized.json","code_commit":"145c589"},"flags":["ambiguous_addressee"]}
