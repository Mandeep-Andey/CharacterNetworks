{"event_id":"ch48_scene_2_e1","scene_id":"ch48_scene_2","chapter_num":48,"book_num":5,"participants":[{"canonical_id":"Dorothea Brooke","display_name":"Dorothea Brooke","role_in_event":"initiator"}],"interaction_kind":"spoken_exchange","direction":"undirected","medium":"spoken","evidence_xml_ids":["ch48_q6","ch48_q7","ch48_q8","ch48_q11","ch48_q12","ch48_q14","ch48_q16","ch48_q19","ch48_q22","ch48_q23","ch48_q25","ch48_q26","ch48_q28","ch48_q30","ch48_q31"],"evidence_texts":["“Are you ill, Edward?”","“I felt some uneasiness in a reclining posture. I will sit here for a time.”","“You would like me to read to you?”","“I fear that the excitement may be too great for you,”","“No, I am not conscious of undue excitement. Thought is easy.”","“Pass on to the next head—I omit the second excursus on Crete.”","“Yes,”","“What is it?”","“No, I do not yet refuse,”","“but it is too solemn—I think it is not right—to make a promise when I am ignorant what it will bind me to. Whatever affection prompted I would do without promising.”","“No, dear, no!”","“But may I wait and reflect a little while? I desire with my whole soul to do what will comfort you; but I cannot give any pledge suddenly—still less a pledge to do I know not what.”","“Grant me till to-morrow,”","“I refuse to content this pining hunger?”","“No! if you die, I will put no finger to your work”"],"dialogue_quote_ids":["ch48_q6","ch48_q7","ch48_q8","ch48_q11","ch48_q12","ch48_q14","ch48_q16","ch48_q19","ch48_q22","ch48_q23","ch48_q25","ch48_q26","ch48_q28","ch48_q30","ch48_q31"],"provenance":{"method":"structural","source_stage":"F_interaction","llm_model":null,"llm_backend":null,"prompt_hash":null,"input_hash":null,"cache_key":null,"alias_kb_version":"char_alias_optimized.json","code_commit":"145c589"},"flags":["ambiguous_addressee"]}
{"event_id":"ch48_scene_2_e2","scene_id":"ch48_scene_2","chapter_num":48,"book_num":5,"participants":[{"canonical_id":"Reverend Edward Casaubon","display_name":"Reverend Edward Casaubon","role_in_event":"initiator"}],"interaction_kind":"spoken_exchange","direction":"undirected","medium":"spoken","evidence_xml_ids":["ch48_q9","ch48_q10","ch48_q13","ch48_q15","ch48_q17","ch48_q18","ch48_q20","ch48_q21","ch48_q24","ch48_q29"],"evidence_texts":["“You would oblige me greatly by doing so, Dorothea,”","“I am wakeful: my mind is remarkably lucid.”","“That will do—mark that”","“Close the book now, my dear. We will resume our work to-morrow. I have deferred it too long, and would gladly see it completed. But you observe that the principle on which my selection is made, is to","“And now I think that I can take some repose,”","“Before I sleep, I have a request to make, Dorothea.”","“It is that you will let me know, deliberately, whether, in case of my death, you will carry out my wishes: whether you will avoid doing what I should deprecate, and apply yourself to do what I should","“You refuse?”","“But you would use your own judgment: I ask you to obey mine; you refuse.”","“Till to-morrow then,”"],"dialogue_quote_ids":["ch48_q9","ch48_q10","ch48_q13","ch48_q15","ch48_q17","ch48_q18","ch48_q20","ch48_q21","ch48_q24","ch48_q29"],"provenance":{"method":"structural","source_stage":"F_interaction","llm_model":null,"llm_backend":null,"prompt_hash":null,"input_hash":null,"cache_key":null,"alias_kb_version":"char_alias_optimized.json","code_commit":"145c589"},"flags":["ambiguous_addressee"]}
