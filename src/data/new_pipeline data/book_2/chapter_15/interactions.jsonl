{"event_id":"ch15_scene_4_e1","scene_id":"ch15_scene_4","chapter_num":15,"book_num":2,"participants":[{"canonical_id":"Madame Laure","display_name":"Madame Laure","role_in_event":"initiator"}],"interaction_kind":"spoken_exchange","direction":"undirected","medium":"spoken","evidence_xml_ids":["ch15_q12","ch15_q13","ch15_q14","ch15_q15","ch15_q16","ch15_q19"],"evidence_texts":["“You have come all the way from Paris to find me?”","“Are all Englishmen like that?”","“I came because I could not live without trying to see you. You are lonely; I love you; I want you to consent to be my wife; I will wait, but I want you to promise that you will marry me—no one else.”","“I will tell you something,”","“My foot really slipped.”","“I meant to do it.”"],"dialogue_quote_ids":["ch15_q12","ch15_q13","ch15_q14","ch15_q15","ch15_q16","ch15_q19"],"provenance":{"method":"structural","source_stage":"F_interaction","llm_model":null,"llm_backend":null,"prompt_hash":null,"input_hash":null,"cache_key":null,"alias_kb_version":"char_alias_optimized.json","code_commit":"145c589"},"flags":["ambiguous_addressee"]}
{"event_id":"ch15_scene_4_e2","scene_id":"ch15_scene_4","chapter_num":15,"book_num":2,"participants":[{"canonical_id":"Tertius Lydgate","display_name":"Tertius Lydgate","role_in_event":"initiator"}],"interaction_kind":"spoken_exchange","direction":"undirected","medium":"spoken","evidence_xml_ids":["ch15_q17","ch15_q18","ch15_q20","ch15_q21","ch15_q22","ch15_q23","ch15_q24"],"evidence_texts":["“I know, I know,”","“It was a fatal accident—a dreadful stroke of calamity that bound me to you the more.”","“There was a secret, then,”","“He was brutal to you: you hated him.”","“No! he wearied me; he was too fond: he would live in Paris, and not in my country; that was not agreeable to me.”","“Great God!”","“And you planned to murder him?”"],"dialogue_quote_ids":["ch15_q17","ch15_q18","ch15_q20","ch15_q21","ch15_q22","ch15_q23","ch15_q24"],"provenance":{"method":"structural","source_stage":"F_interaction","llm_model":null,"llm_backend":null,"prompt_hash":null,"input_hash":null,"cache_key":null,"alias_kb_version":"char_alias_optimized.json","code_commit":"145c589"},"flags":["ambiguous_addressee"]}
